{
  "expo": {
    "name": "Ansita Beauty Parlor",
    "slug": "ansita-parlor-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ansita.parlor"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF8F3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ansita.parlor"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "ansita",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Ansita to access your photos to set a profile picture.",
          "cameraPermission": "Allow Ansita to use your camera to take a profile picture."
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FBF8F3"
        }
      ]
    ]
  }
}

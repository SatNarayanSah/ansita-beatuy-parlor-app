# Copy to .env for local development. Every value has a safe local default.

# Local: SQLite file. Production: your Postgres URL (Neon / Supabase), e.g.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./ansita.db

# Long random string, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_DAYS=30

TIMEZONE=Asia/Kathmandu
CORS_ORIGINS=*

# Public address of this API, used to build links to uploaded images. Optional:
# when empty it comes from each request (Render's forwarded https headers are trusted).
PUBLIC_URL=

# Phone notifications are sent through Expo's push service (no setup needed here).
# EXPO_ACCESS_TOKEN is only required if "Enhanced push security" is on in Expo.
PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=

# ---------- Email: sign-up verification codes and password-reset codes ----------
# Sent over SMTP. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=you@gmail.com,
# SMTP_PASSWORD=<a 16-letter Google App Password (myaccount.google.com/apppasswords), not
# your normal password>, MAIL_FROM_EMAIL=you@gmail.com. Note: Render's free plan blocks
# outgoing SMTP; a paid instance (or another host) is needed there.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=false
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Ansita Beauty Parlour
# Email design: edit app/email_templates/code.html (preview: python -m app.preview_email).
# Optional public https link to the logo shown at the top, e.g. https://your-site/brand/logo.png
MAIL_LOGO_URL=
# Address customers are told to write to; defaults to MAIL_FROM_EMAIL.
MAIL_CONTACT=
# Rejects emails whose domain does not exist (e.g. "gmial.com") before sending a code.
EMAIL_CHECK_DELIVERABILITY=true
# Ask for an emailed code at sign-up / email change. Set false where email can't be sent
# (Render's free plan blocks SMTP); the code stays in place to switch back on later.
EMAIL_VERIFICATION_ENABLED=false

# Development only: while no email provider is set above, codes are returned in the API
# response and shown on screen. Ignored once email is configured. Set false in production.
EXPOSE_RESET_CODE=true

# First admin account, created by `python -m app.seed`. Required: there is no default
# login. Use a real email and a strong password (8+ characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Ansita Shrestha
ADMIN_PHONE=+9779854028392
